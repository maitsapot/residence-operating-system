APP_NAME=ROS API
APP_VERSION=1.0.0
SERVICE_NAME=ros-api
ENVIRONMENT=dev

# Local compose default:
API_DATABASE_URL=postgresql+psycopg2://ros:ros@db:5432/ros
DATABASE_URL=postgresql+psycopg2://ros:ros@localhost:5432/ros
TEST_DATABASE_URL=postgresql+psycopg2://ros:ros@localhost:5432/ros_test

API_PORT=8000

# In production, set exact origins. Do not use * with credentials enabled.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text

POSTGRES_DB=ros
POSTGRES_USER=ros
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
