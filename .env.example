# ================================

# APPLICATION SETTINGS

# ================================

APP_NAME=ROS API
APP_VERSION=1.0.0
SERVICE_NAME=ros-api
ENVIRONMENT=dev

# ================================

# DATABASE CONFIGURATION

# ================================

# Primary database (LIVE system)

DATABASE_URL=postgresql+psycopg2://tebogo:Karu8082$@localhost:5432/ros_mobile

# Test database (for testing / QA)

TEST_DATABASE_URL=postgresql+psycopg2://tebogo:Karu8082$@localhost:5432/ros_mobile_test

# NOTE:

# - Using localhost because Postgres is running in Docker on this VM

# - User: tebogo (from recovered database)

# - Password: explicitly set for stability going forward

# ================================

# API CONFIGURATION

# ================================

API_PORT=8000

# ================================

# CORS SETTINGS (Frontend access)

# ================================

# In production, replace with exact domains

CORS_ALLOW_ORIGINS=[http://localhost:3000,http://localhost:5173](http://localhost:3000,http://localhost:5173)
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ================================

# LOGGING CONFIGURATION

# ================================

LOG_LEVEL=INFO

# Options: text | json

LOG_FORMAT=text

# ================================

# POSTGRES METADATA (OPTIONAL)

# ================================

# These are not used directly by the API,

# but useful for scripts / docker / documentation

POSTGRES_DB=ros_mobile
POSTGRES_USER=tebogo
POSTGRES_PASSWORD=Karu8082$
POSTGRES_PORT=5432
